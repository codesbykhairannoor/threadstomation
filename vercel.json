{
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "lib/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/supabase-media/(.*)",
      "destination": "https://ejqpkdwxkkcwiyfoqsfd.supabase.co/storage/v1/object/public/media/$1"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/term-of-service.html"
    },
    {
      "source": "/term-of-service",
      "destination": "/term-of-service.html"
    },
    {
      "source": "/api/tiktok/(.*)",
      "destination": "/api/tiktok.mjs"
    },
    {
      "source": "/api/instagram/(.*)",
      "destination": "/api/instagram.mjs"
    },
    {
      "source": "/api/facebook/(.*)",
      "destination": "/api/facebook.mjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
