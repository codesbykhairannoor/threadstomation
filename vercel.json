{
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service/index.html"
    },
    {
      "source": "/term-of-service",
      "destination": "/term-of-service/index.html"
    },
    {
      "source": "/api/tiktok/(.*)",
      "destination": "/api/tiktok.mjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
